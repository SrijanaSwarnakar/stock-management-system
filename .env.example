# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-direct.region.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-key-change-this-in-production-12345678"

# Application Settings
NEXT_PUBLIC_APP_NAME="Shree Ganesh Traders"
